# Variables de production : à saisir dans Coolify (onglet Environment Variables),
# ou à copier en prod.env (jamais commité) pour un déploiement sans Coolify.
# Générer les secrets avec : openssl rand -base64 32

# Domaine public sans https:// (ex. soukoulou.duckdns.org) : le même que celui du service web dans Coolify.
DOMAIN=

POSTGRES_PASSWORD=
JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=
S3_SECRET_KEY=

# Compte admin Soukoulou créé par le seed (premier déploiement).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

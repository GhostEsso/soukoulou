# Variables pour docker-compose.prod.yml (serveur à soi) : à saisir dans Coolify,
# ou à copier en prod.env (jamais commité) pour un déploiement sans Coolify.
# Générer les secrets avec : openssl rand -base64 32

# Domaine public sans https:// (ex. soukoulou.duckdns.org) : celui du service web.
DOMAIN=

POSTGRES_PASSWORD=
JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=
S3_SECRET_KEY=

# Compte admin Soukoulou créé par le seed (premier déploiement).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
